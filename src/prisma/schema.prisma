generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserType {
  admin
  user
  external
}

model User {
  id                 Int       @id @default(autoincrement())
  firstname          String?
  lastname           String?
  email              String    @unique
  password           String?
  usertype           UserType
  orderExportColumns String?
  lastPasUpdate      DateTime?
  active             Boolean?  @default(true)
  isBlocked          Boolean   @default(false)
  blockMailSent      Boolean   @default(false)
  token              String?
  googleId           String?
  profilePicture     String?
  googleAcessToken   String?
  CreatedAt          DateTime?
  ModifiedBy         Int?
  CreatedBy          Int?
  ModifiedAt         DateTime?

  activityLogs      ActivityLog[]
  passwordHistories PasswordHistory[]
  productLogs       ProductLog[]

  @@map("user")
}

enum ActivityType {
  Store
  BlueSky
}

model ActivityLog {
  id           Int          @id @default(autoincrement())
  userId       Int?
  email        String?
  firstname    String?
  lastname     String?
  url          String?
  lastModifyOn DateTime?
  ipAddress    String?
  type         ActivityType
  env          String?
  user         User?        @relation(fields: [userId], references: [id])

  @@map("activity_log")
}

model PasswordHistory {
  id        Int      @id @default(autoincrement())
  password  String
  userId    Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("password_history")
}

model Customer {
  id              Int      @id @default(autoincrement())
  firstName       String
  lastName        String
  email           String   @unique
  password        String
  company         String
  billingAddress1 String
  billingAddress2 String   @default("")
  city            String
  postalCode      String
  state           String
  country         String
  phoneNumber     String
  discount        Float?   @default(0.0)
  active          Boolean  @default(false)
  hide            Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("customer")
}

model EndUser {
  id              Int      @id @default(autoincrement())
  firstName       String
  lastName        String
  email           String   @unique
  company         String
  billingAddress1 String
  billingAddress2 String   @default("")
  city            String
  postalCode      String
  state           String
  country         String
  phoneNumber     String
  discount        Float?   @default(0.0)
  external        Boolean  @default(false)
  hide            Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("end_user")
}

model Rma {
  id               Int      @id @default(autoincrement())
  sn               String   @unique
  rmaNumber        String   @unique
  device           String
  po               String
  receivedBy       String
  issuedDate       DateTime
  receivedDateTime DateTime
  ready            Boolean
  holdingTime      Int
  extraInfo        String?

  @@map("rma")
}

enum TagType {
  Product
  Reseller
  Company
}
model Tag {
  id              Int     @id @default(autoincrement())
  title           String  @unique
  description     String?
  backgroundColor String
  type            TagType @default(Product)
  active          Boolean @default(true)
  typeId          Int     @default(0)
  color           String  @default("white")
  createdBy       String  @default("system")
  updatedBy       String  @default("system")

  @@map("tag")
}

model File {
  id    Int    @id @default(autoincrement())
  title String @unique
  URL   String

  @@map("file")
}

model Product {
  ProductID                      Int      @id @default(autoincrement())
  ProductCode                    String?  
  ProductName                    String?  
  ProductDescriptionShort        String?  
  ProductDescription             String?  
  ProductNameShort               String?  
  ProductPrice                   Float    @default(0) 
  ProductPriceYuan               Float    @default(0) 
  ProductPriceYen                Float    @default(0) 
  ProductPriceEuro               Float    @default(0) 
  ProductPricePound              Float    @default(0) 
  ProductPriceWON                Float    @default(0) 
  ProductPriceINR                Float    @default(0) 
  ProductWeight                  Float?   
  FreeShippingItem               Boolean? 
  Photo_AltText                   String?  
  Hide_FreeAccessories            Boolean? 
  TaxableProduct                 Boolean? 
  TechSpecs                      String?  
  HideProduct                    Boolean? 
  ModifyOn                       DateTime? 
  CreatedOn                      DateTime? 
  StockStatus                    String?  
  Availability                   String?  
  ProductPrice_Name               String? 
  ProductManufacturer            String?  
  SalePrice_Name                  String?  
  Accessories                    String?  
  OptionIDs                      String?  
  FreeAccessories                String?  
  ProductDetailURL               String? 
  ExtInfo                        String?  
  ProductDescription_AbovePricing String?  
  ProductPhotoURL                String?  
  Discount                       Float    @default(0) 
  METATAG_Description             String?  
  METATAG_Keywords                String?  
  PriorityIndex                  Int      @default(1000)
  HideWhenOutOfStock             Boolean  @default(false) 
  isActive                       Boolean  @default(true) 
  isCompleted                    Boolean? @default(true) 
  isDeleted                      Boolean  @default(false) 
  isFeatured                     Boolean  @default(false)
  TitleImage                     String?  
  isSerialAble                   Boolean  @default(false) 
  isFreeProduct                  Boolean  @default(false) 
  HarmonizedCode                 String? 
  ExportControlClassificationNumber String?  @default("EAR99") 
  UnitOfMeasure                  String?  
  CountryOfOrigin                String?  @default("US") 
  ExportDescription              String?  
  GroupId                        Int? 
  backlog_leadtime                String?  
  backlog_comments                String?  
  backlog_priority                Int      @default(1000) 
  backlog_show                    Boolean  @default(false) 
  updatedDateBacklogComment      DateTime? 
  holdForApproval                Boolean  @default(false) 
  Accessory                      Boolean  @default(false) 
  Maintenance                    Boolean  @default(false) 
  Upgrade                        Boolean  @default(false) 
  Resale                         Boolean  @default(false) 
  productClassId                 Int?  
  productSubClassId              Int?  
  gpn                            String?  
  StoreCategory                  Int      @default(1) 
  isMultiClassification          Boolean? @default(false) 
  CreatedBy                      String?  
  ModifiedBy                     String?  

  details           ProductDetail[]
  productLogs       ProductLog[] 
  productClass      ProductClass?    @relation(fields: [productClassId], references: [Id])
  productSubClass   ProductSubClass? @relation(fields: [productSubClassId], references: [Id])
  tagTables         TagTable[]
  @@map("products")
}

model ProductDetail {
  ProductDetailID Int      @id @default(autoincrement())
  ProductID       Int
  Name            String
  URL             String
  isActive        Boolean  @default(true)
  CreatedAt       DateTime?

  product         Product  @relation(fields: [ProductID], references: [ProductID])
  images          Image[]  @relation("DetailImages")

  @@map("product_details")
}

model Image {
  ID           Int      @id @default(autoincrement())
  TableID      Int
  TableName    String
  ImageURL     String
  DisplayOrder Int      @default(0)
  CreatedAt    DateTime?
  isThumb      Boolean?

  productDetail ProductDetail? @relation("DetailImages", fields: [TableID], references: [ProductDetailID])

  @@map("images")
}

model ProductClass {
  Id           Int     @id @default(autoincrement())         
  Name         String
  products     Product[]

  @@map("product_class")
}

model ProductSubClass {
  Id           Int     @id @default(autoincrement())         
  Name         String
  products     Product[]

  @@map("product_subclass")
}

model ProductLog {
  id         Int      @id @default(autoincrement())
  product_id  Int?     
  operation  String?  
  timestamp  DateTime @default(now())
  user_id     Int?     
  old_data    Json?  
  new_data    Json?  

  @@map("products_log") 

  user       User?     @relation(fields: [user_id], references: [id])
  product    Product?  @relation(fields: [product_id], references: [ProductID])
}

model ProductCategory {
  ID         Int      @id @default(autoincrement())
  CategoryID Int
  ProductID  Int
  CreatedAt  DateTime @default(now())
  storeCat   Int      @default(0)

  @@map("product_category") 
}

model OptionCategories {
  id                          Int      @id @default(autoincrement())
  headingGroup                String?  
  optionCategoriesDesc        String   @default("")
  isRequired                  Boolean  
  displayType                 String?  
  arrangeOptionCategoriesBy   Int      @default(0)
  lastModified                DateTime?
  lastModBy                   Int
  hideOptionCategoriesDesc    Boolean  @default(false)
  includeInSearchRefinement   Boolean  @default(false)
  aboutOptionCategories       String?
  useGoogleSize               Boolean  @default(false)
  useGoogleColor              Boolean  @default(false)
  useGoogleMaterial           Boolean  @default(false)
  useGooglePattern            Boolean  @default(false)
  index                       Int?     @map("$index")
  createdAt                   DateTime? @default(now())
  createdBy                   Int?

  @@map("option_categories") 
}

enum TableEnum {
  customers
  orders
  quotes
  products
}

model TagTable {
  id        Int      @id @default(autoincrement())
  tableName TableEnum?
  tableId   Int
  tagid     Int
  product   Product?   @relation(fields: [tableId], references: [ProductID])

  @@map("tag_tables")
}
