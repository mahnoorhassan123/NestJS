generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserType {
  admin
  user
  external
}

model User {
  id                  Int      @id @default(autoincrement())
  firstname           String?  
  lastname            String?
  email               String   @unique
  password            String?  
  usertype            UserType
  orderExportColumns String?
  lastPasUpdate     DateTime?
  active              Boolean? @default(true)
  isBlocked          Boolean  @default(false)
  blockMailSent     Boolean  @default(false)
  token               String?
  googleId           String?
  profilePicture     String?
  googleAcessToken  String?
  CreatedAt          DateTime?
  ModifiedBy         Int?
  CreatedBy          Int?
  ModifiedAt         DateTime?

  activityLogs       ActivityLog[]
  passwordHistories  PasswordHistory[] 
  attachedFiles      AttachedFile[] @relation("UploadedBy")
  orders             Order[]        @relation("OrderedBy")
  ordersShipped             Order[]        @relation("ShippedBy")
  quotes             Quote[]        @relation("OrderedBy")
   OrdersSnapshot OrdersSnapshot[] @relation("ModifiedBy")
  Order Order[] @relation("ModifiedBy")
  ProductLog ProductLog[]
  @@map("user")
 
}


enum ActivityType {
  Store
  BlueSky
}

model ActivityLog {
  id            Int          @id @default(autoincrement())
  userId        Int?
  email         String?
  firstname     String?
  lastname      String?
  url           String?
  lastModifyOn  DateTime?
  ipAddress     String?
  type          ActivityType 
  env           String?
  user          User?    @relation(fields: [userId], references: [id])

  @@map("activity_log")
}

model PasswordHistory {
  id         Int      @id @default(autoincrement())
  password   String
  userId     Int
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id])

  @@map("password_history") 
}

model Customer {
  id              Int      @id @default(autoincrement())
  firstName       String
  lastName        String
  email           String   @unique
  password        String
  company         String
  billingAddress1 String
  billingAddress2 String   @default("")
  city            String
  postalCode      String
  state           String
  country         String
  phoneNumber     String
  discount        Float?   @default(0.0)
  active          Boolean  @default(false)
  hide            Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       Int?
  modifiedBy      Int?
  orders          Order[]  @relation("CustomerOrders")
  salesRepOrders  Order[]  @relation("SalesRepOrders")

  @@map("customer")
}

model EndUser {
  id              Int      @id @default(autoincrement())
  firstName       String
  lastName        String
  email           String   @unique
  company         String
  billingAddress1 String
  billingAddress2 String   @default("")
  city            String
  postalCode      String
  state           String
  country         String
  createdBy       Int?
  modifiedBy      Int?
  phoneNumber     String
  discount        Float?   @default(0.0)
  external        Boolean  @default(false)
  hide            Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  orders          Order[]  @relation("EndUserOrders")  

  @@map("end_user")
}

model AttachedFile {
  id          Int      @id @default(autoincrement())
  orderId     Int?
  quoteId     Int?
  name        String
  type        String
  file        String
  extension   String
  uploadedBy  Int
  uploadedAt  DateTime @default(now())
  isDeleted   Boolean  @default(false)
  createdAt   DateTime @default(now())
  order       Order?   @relation(fields: [orderId], references: [id])
  quote       Quote?   @relation(fields: [quoteId], references: [id])
  user        User     @relation("UploadedBy", fields: [uploadedBy], references: [id])

  @@map("attached_files")
}

model OrderTrackingNo {
  id              Int                      @id @default(autoincrement())
  orderId         Int 
  trackingNo      String                   @unique
  gateway         String?                
  shipDate        DateTime?                
  shipmentCost    Float?                  
  shippingMethodId Int?                    
  orderType       String?
  updatedBy       Int?
  createdAt       DateTime                 @default(now())
  Package         String?                    
  Form            String?                 
  isImported      Boolean?                 @default(false)  
  order           Order?                   @relation(fields: [orderId], references: [id])
  lineItems       TrackingShippingLineItem[]

  @@map("order_tracking_no")
}

model TrackingShippingLineItem {
  id              Int             @id @default(autoincrement())
  trackShippingId Int
  orderId         Int?
  displayOrder    Int?
  quantity        Int?
  productId       Int?
  productCode     String?
  productDescription String?
  isChild         Boolean?
  createdAt       DateTime?
  createdBy       Int?
  updatedAt       DateTime        @updatedAt
  updatedBy       Int?
  tracking        OrderTrackingNo @relation(fields: [trackShippingId], references: [id])

  @@map("tracking_shipping_lineitems")
}

model OrderPackage {
  id        Int      @id @default(autoincrement())
  orderId   Int
  name      String?
  quantity  Int?
  price     Float?
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id])

  @@map("order_packages")
}

model OrdersSnapshot {
  id            Int      @id @default(autoincrement())
  orderId       Int
  orderComments String?
  orderNotes    String?
  lastModBy     Int?
  lastModified  DateTime?
  order         Order?   @relation(fields: [orderId], references: [id])
  modifiedBy    User?    @relation("ModifiedBy", fields: [lastModBy], references: [id])  

  @@map("orders_snapshot")
}



model Order {
  id                             Int           @id
  accountNumber                  String?       @db.Text
  accountType                    String?       @db.Text
  addressValidated               String?       @db.Text
  affiliateCommissionableValue   Float?        
  orderTaxExempt                 Boolean       @default(false) 
  authHash                       String?       @db.Text
  avs                            String?       @db.Text
  bankName                       String?       @db.Text
  batchNumber                    Int?          
  billingAddress1                String?       @db.Text
  billingAddress2                String?       @db.Text
  billingCity                    String?       @db.Text
  billingCompanyName             String?       @db.Text
  billingCountry                 String?       @db.Text
  billingFaxNumber               String?       @db.Text
  billingFirstName               String?       @db.Text
  billingLastName                String?       @db.Text
  billingPhoneNumber             String?       @db.Text
  billingPostalCode              String?       @db.Text
  billingState                   String?       @db.Text
  cancelDate                     String?       @db.Text
  cancelReason                   String?       @db.Text
  cardHoldersName                String?       @db.Text
  cashTender                     Float?   
  ccLast4                        String?       @db.Text
  checkNumber                    String?       @db.Text
  creditCardAuthorizationDate    String?       @db.Text
  creditCardAuthorizationNumber  String?       @db.Text
  creditCardExpDate              String?       @db.Text
  creditCardIssueDate            String?       @db.Text
  creditCardIssueNumber          String?       @db.Text
  creditCardTransactionId        String?       @db.Text
  creditCardAuthorizationHash    String?       @db.Text
  customFieldCarrierAcctNo       String?       @db.Text
  customFieldCustom2             String?       @db.Text
  customFieldCustom3             String?       @db.Text
  customFieldCustom4             String?       @db.Text
  customFieldCustom5             String?       @db.Text
  customerIpAddress              String?       @db.Text
  customerId                     Int?   
  cvv2Response                   String?       @db.Text
  dvCreditCardNumber             String?       @db.Text
  giftCardIdUsed                 String?       @db.Text
  giftWrapNote                   String?       @db.Text
  initiallyShippedDate           String?       @db.Text
  isAGift                        String?       @db.Text
  isGTSOrder                     String?       @db.Text
  lastModBy                      Int?      
  lastModified                   String?       @db.Text
  locked                         String?       @db.Text
  micr                           String?       @db.Text
  orderComments                  String?       @db.Text
  orderEntrySystem               String?       @db.Text
  orderDate                      String?       @db.Text
  invoiceableOn                  DateTime?     
  orderDateUtc                   String?       @db.Text
  orderIdThirdParty              String?       @db.Text
  orderIdThirdPartyLink          String?       @db.Text
  orderNotes                     String?       @db.Text
  orderStatus                    String?       @db.Text
  paymentAmount                  Float?        
  paymentDeclined                String?       @db.Text
  paymentMethodId                Int?          
  pciaasCardId                   String?       @db.Text
  pciaasMaskedCardRef            String?       @db.Text
  poNum                          String?       @db.Text
  printed                        String?       @db.Text
  processedAutoEvents            String?       @db.Text
  routingNumber                  String?       @db.Text
  salesRepCustomerId             Int?          
  salesTax1                      Float?        
  salesTax2                      Float?        
  salesTax3                      Float?        
  salesTaxRate                   Float?        
  salesTaxRate1                  Float         @default(0)
  salesTaxRate2                  Float         @default(0)
  salesTaxRate3                  Float         @default(0)
  shipAddress1                   String?       @db.Text
  shipAddress2                   String?       @db.Text
  shipCity                       String?       @db.Text
  shipCompanyName                String?       @db.Text
  shipCountry                    String?       @db.Text
  shipDate                       String?       @db.Text
  shipFaxNumber                  String?       @db.Text
  shipFirstName                  String?       @db.Text
  shipLastName                   String?       @db.Text
  shipped                        String?       @db.Text
  shipPhoneNumber                String?       @db.Text
  shippingLocked                 String?       @db.Text
  shippingMethodId               Int?          
  shipPostalCode                 String?       @db.Text
  shipResidential                String?       @db.Text
  shipState                      String?       @db.Text
  sOrderId                       String?       @db.Text
  stockPriority                  Int?          
  tax1IgnoreNoTaxRules           String?       @db.Text
  tax1Title                      String?       @db.Text
  tax2IgnoreNoTaxRules           String?       @db.Text
  tax2IncludePrevious            Int?          
  tax2Title                      String?       @db.Text
  tax3IgnoreNoTaxRules           String?       @db.Text
  tax3IncludePrevious            Int?          
  tax3Title                      String?       @db.Text
  taxRateIsVat                   String?       @db.Text
  totalPaymentAuthorized         Float?       
  totalPaymentReceived           Float?       
  totalShippingCost              Float?        
  vendorId                       Int?    
  pdfName                        String?       @db.Text
  isCustomerNameShow             Boolean       @default(true) 
  isCustomerEmailShow            Boolean       @default(true)
  quoteNo                        Int?                  
  orderType                      String?        @default("Customer") 
  userId                         Int?          
  orderSerials                   String?       @db.Text
  oldOrder                       Boolean       @default(false) 
  isTaxExempt                    Boolean       @default(false)
  taxExemptionId                 Int?        
  isPayed                        Boolean       @default(false) 
  listPriceName                  String?       @db.Text
  currentCustomerDiscount        Int           @default(0) 
  insuranceValue                 Int           @default(0) 
  isFreeOrder                    Boolean       @default(false) 
  incoterm                       String?       @db.Text
  trackingNo                     String?       @db.Text
  endUserId                      Int?       
  shipEmailAddress               String?       @db.Text
  shippedBy                      Int?          
  convertedFromQuote             Boolean       @default(false) 
  createdAt                      DateTime      @default(now())
  updatedAt                      DateTime      @updatedAt
  packages                       OrderPackage[]
  files                          AttachedFile[]
  tracking                       OrderTrackingNo[]
  quote                          Quote?
  customer                       Customer?     @relation("CustomerOrders", fields: [customerId], references: [id])
  orderedBy                      User?         @relation("OrderedBy", fields: [lastModBy], references: [id], map: "orders_orderedBy_fkey")
  modifiedBy                     User?         @relation("ModifiedBy", fields: [lastModBy], references: [id], map: "orders_lastModBy_fkey")
  shippedByUser                  User?         @relation("ShippedBy", fields: [shippedBy], references: [id])
  orderDetails                   OrderDetail[]
  salesRep                       Customer?     @relation("SalesRepOrders", fields: [salesRepCustomerId], references: [id])
  endUser                        EndUser?      @relation("EndUserOrders", fields: [endUserId], references: [id])
  snapshots                      OrdersSnapshot[]
  productSerials                 ProductSerial[]
  tagTable                       TagTable[] @relation("TagTable")
  

  @@map("orders")
}



model OrderDetail {
  id                                  Int      @id @default(autoincrement()) 
  orderId                             Int?     
  productId                           Int?     
  productCode                         String?  
  description                         String?   @db.Text
  qtyOnPackingSlip                    Int?     
  isChild                             Boolean? @default(false) 
  showOnShippingSlip                  Boolean  @default(true) 
  parent                              String?  
  parentName                          String?  
  displayOrder                        Int      @default(0)
  productName                         String?  
  harmonizedCode                      String?  
  exportControlClassificationNumber   String?  @default("EAR99") 
  productWeight                       Float?   
  unitOfMeasure                       String? 
  countryOfOrigin                     String?  @default("US")
  exportDescription                   String? 
  quantity                            Int?    
  productPrice                        Float?  
  discountValue                       Float    @default(0) 
  productSubClass                     String?  
  taxableProduct                      String?  
  qtyShipped                          Int?    
  qtyOnBackOrder                      Int?    
  productSerials                      String? 
  isCategoriesOption                  Boolean? @default(false) 
  optionId                            Int?     
  categoryIdOfOption                  String?
  options                             String? 
  additionalHandlingIndicator         String?  
  affiliateCommissionableValue        Float?  
  autoDropShip                        String? 
  categoryID                          Int?  
  couponCode                          String?
  customLineItem                      String? 
  discountAutoID                      Int?    
  discountType                        Int?    
  downloadFile                        String? 
  fixedShippingCost                   Float?  
  fixedShippingCostOutsideLocalRegion Float?   
  freeShippingItem                    String?  
  giftTrakNumber                      Int?     
  giftWrap                            String? 
  giftWrapCost                        Float?   
  giftWrapNote                        String?  
  height                              Float? 
  isKitID                             String?  
  kitID                               String?  
  lastModBy                           Int?     
  lastModified                        String?  
  length                              Float? 
  locked                              String?  
  onOrderQty                          Int?     
  optionIDs                           String?
  orderDetailIDThirdParty             String?  
  orderDetailIDThirdPartyLink         String?  
  oversized                           String?
  packageType                         String?  
  productKeysShipped                  String?  
  productNote                         String?  
  qtyOnHold                           Int?     
  returned                            String?
  returnedDate                        String?
  rewardPointsGivenForPurchase        Int?    
  rmaNumber                           Int?     
  rmaiID                              Int?    
  shipDate                            String? 
  shipped                             String? 
  shipsByItself                       String?  
  totalPrice                          Float? 
  vatPercentage                       Float?   
  vendorPrice                         Float?   
  warehouses                          String? 
  width                               Float?
  orderDetailsOptions                 String? 
  productTax                          Float    @default(0) @map("ProductTax")
  freeShippingDiscount                String?  @map("FreeShippingDiscount") @db.Text
  nonShippable                        String?  @map("NonShippable") @db.Text
  packingSlipCheck                    String   @default("y") @map("packingSlipCheck") @db.VarChar(45)
  createdAt                           DateTime @default(now())
  order                               Order?   @relation(fields: [orderId], references: [id])
  product                             Product? @relation(fields: [productId], references: [productId])

  @@map("order_details")
}


model Quote {
  id         Int      @id @default(autoincrement())
  quoteNo    Int      @unique
  isOrdered  Boolean  @default(false)
  orderBy    Int?
  orderId    Int?     @unique
  quoteDate  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  order      Order?   @relation(fields: [orderId], references: [id])
  user       User?    @relation("OrderedBy", fields: [orderBy], references: [id])
  files      AttachedFile[]

  @@map("quotes")
}
model ProductSerial {
  id               Int      @id @default(autoincrement())
  productId        Int?    
  serialNo         String   
  orderId          Int?  
  isStock          Boolean  @default(false)
  isProduction     Boolean  @default(false) 
  isSold           Boolean  @default(false) 
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt
  status           ProductSerialStatus @default(unAllocated)
  type             ProductSerialType   @default(products)
  groupId          Int?    
  product          Product? @relation(fields: [productId], references: [productId])
  order            Order?   @relation(fields: [orderId], references: [id])

  @@unique([serialNo])
  @@unique([serialNo, productId])
  @@map("product_serials")
}

enum ProductSerialStatus {
  allocated
  unAllocated
  shipped
}

enum ProductSerialType {
  products
  groups
}

model TagTable {
  id        Int      @id @default(autoincrement())
  tableId   Int  
  tableName String
  tagId     Int
  
  createdAt DateTime @default(now())
  tag       Tag?     @relation("Tag", fields: [tagId], references: [id])
  Order     Order? @relation("TagTable",fields: [tableId],references: [id])
  
  
  @@map("tag_tables")
}

model Tag {
  id              Int    @id @default(autoincrement())
  title           String
  description     String?
  backgroundColor String
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now())
  createdBy       Int?
  updatedBy       Int?
  color           String    @default("white")
  typeId          Int 
  tagTable        TagTable[] @relation("Tag")
 

  @@map("tags")
}

model ShippingMethod {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())

  @@map("shipping_methods")
}






model Product {
  productId                      Int      @id @default(autoincrement())
  productCode                    String?  
  productName                    String?  
  productDescriptionShort        String?  
  productDescription             String?  
  productNameShort               String?  
  productPrice                   Float    @default(0) 
  productPriceYuan               Float    @default(0) 
  productPriceYen                Float    @default(0) 
  productPriceEuro               Float    @default(0) 
  productPricePound              Float    @default(0) 
  productPriceWon                Float    @default(0) 
  productPriceInr                Float    @default(0) 
  productWeight                  Float?   
  freeShippingItem               Boolean? 
  photoAltText                   String?  
  hideFreeAccessories            Boolean? 
  taxableProduct                 Boolean? 
  techSpecs                      String?  
  hideProduct                    Boolean? 
  modifyOn                       DateTime? 
  createdOn                      DateTime? 
  stockStatus                    String?  
  availability                   String?  
  productPriceName               String? 
  productManufacturer            String?  
  salePriceName                  String?  
  accessories                    String?  
  optionIds                      String?  
  freeAccessories                String?  
  productDetailUrl               String? 
  extInfo                        String?  
  productDescriptionAbovePricing String?  
  productPhotoUrl                String?  
  discount                       Float    @default(0) 
  metaTagDescription             String?  
  metaTagKeywords                String?  
  priorityIndex                  Int      @default(1000)
  hideWhenOutOfStock             Boolean  @default(false) 
  isActive                       Boolean  @default(true) 
  isCompleted                    Boolean? @default(true) 
  isDeleted                      Boolean  @default(false) 
  isFeatured                     Boolean  @default(false)
  titleImage                     String?  
  isSerializable                 Boolean  @default(false) 
  isFreeProduct                  Boolean  @default(false) 
  harmonizedCode                 String? 
  exportControlClassificationNumber String?  @default("EAR99") 
  unitOfMeasure                  String?  
  countryOfOrigin                String?  @default("US") 
  exportDescription              String?  
  groupId                        Int? 
  backlogLeadtime                String?  
  backlogComments                String?  
  backlogPriority                Int      @default(1000) 
  backlogShow                    Boolean  @default(false) 
  updatedDateBacklogComment      DateTime? 
  holdForApproval                Boolean  @default(false) 
  accessory                      Boolean  @default(false) 
  maintenance                    Boolean  @default(false) 
  upgrade                        Boolean  @default(false) 
  resale                         Boolean  @default(false) 
  productClassId                 Int?  
  productSubClassId              Int?  
  gpn                            String?  
  storeCategory                  Int      @default(1) 
  isMultiClassification          Boolean? @default(false) 
  createdBy                      String?  
  modifiedBy                     String?  

  details           ProductDetail[]
  productLogs       ProductLog[] 
  productClass      ProductClass?    @relation(fields: [productClassId], references: [id])
  productSubClass   ProductSubClass? @relation(fields: [productSubClassId], references: [id])
  ProductSerial ProductSerial[]
  OrderDetail OrderDetail[]

  @@map("products")

}

model ProductDetail {
  productDetailId Int      @id @default(autoincrement())
  productId       Int
  name            String
  url             String
  isActive        Boolean  @default(true)
  createdAt       DateTime?

  product         Product  @relation(fields: [productId], references: [productId])
  images          Image[]  @relation("DetailImages")

  @@map("product_details")
}

model Image {
  id           Int      @id @default(autoincrement())
  tableId      Int
  tableName    String
  imageUrl     String
  displayOrder Int      @default(0)
  createdAt    DateTime?
  isThumb      Boolean?

  productDetail ProductDetail? @relation("DetailImages", fields: [tableId], references: [productDetailId])

  @@map("images")
}

model ProductClass {
  id           Int     @id @default(autoincrement())         
  name         String
  products     Product[]

  @@map("product_class")
}

model ProductSubClass {
  id           Int     @id @default(autoincrement())         
  name         String
  products     Product[]

  @@map("product_subclass")
}

model ProductLog {
  id         Int      @id @default(autoincrement())
  productId  Int?     
  operation  String?  
  timestamp  DateTime @default(now())
  userId     Int?     
  oldData    Json?  
  newData    Json?  

  user       User?     @relation(fields: [userId], references: [id])
  product    Product?  @relation(fields: [productId], references: [productId])

  @@map("products_log") 
}

model ProductCategory {
  id         Int      @id @default(autoincrement())
  categoryId Int
  productId  Int
  createdAt  DateTime @default(now())
  storeCat   Int      @default(0)

  @@map("product_category") 
}